<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Surec baslarken uygulanan tema (sistem Karanlik Mod KAPALI iken).
         Parent `Theme.Light` yerine `Theme.Black`: acik tema beyaz bir pencere
         zemini getiriyordu ve oyun karanlik oldugu icin acilista beyaz parlama
         olusuyordu. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Acilis ekrani. Flutter ilk kareyi cizdiginde otomatik kaldirilir. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Surec baslar baslamaz uygulanan tema. Flutter arayuzu yuklenirken ve
         calisirken PENCERE zeminini belirler. Oyunun uzay rengiyle ayni olmasi
         onemli: aksi halde ilk kare cizilene kadar farkli bir renk gorunur. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/marsky_space</item>
    </style>
</resources>
